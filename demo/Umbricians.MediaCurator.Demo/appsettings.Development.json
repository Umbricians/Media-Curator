{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Data Source=|DataDirectory|/Umbraco.sqlite.db;Foreign Keys=True;Pooling=True",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.Sqlite",
    "umbracoAutomateDbDSN": "Data Source=|DataDirectory|/UmbracoAutomate.sqlite.db;Foreign Keys=True;Pooling=True",
    "umbracoAutomateDbDSN_ProviderName": "Microsoft.Data.Sqlite"
  },
  "Umbraco": {
    "CMS": {
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Demo Admin",
        "UnattendedUserEmail": "admin@example.test",
        "UnattendedUserPassword": "MediaCuratorDemo!2026",
        "UnattendedTelemetryLevel": "Detailed"
      },
      "Hosting": {
        "Debug": true
      },
      "Global": {
        "DisableElectionForSingleServer": true
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "http://localhost:40264"
      }
    },
    "Automate": {
      "Execution": {
        "MaxConcurrentRuns": 1
      },
      "RateLimiting": {
        "MaxConcurrentRunsPerAutomation": 1
      },
      "Outbox": {
        "MaxRetries": 12,
        "BaseRetryDelay": "00:00:10"
      }
    }
  },
  "MediaCuratorDemo": {
    "SeedSampleContent": true
  }
}
