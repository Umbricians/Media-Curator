<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbricians.MediaCurator.Automate</PackageId>
    <Product>Umbricians.MediaCurator.Automate</Product>
    <Title>Umbricians Media Curator Automate</Title>
    <Description>Adds Media Curator triggers and actions to Umbraco.Automate workflows.</Description>
    <Authors>Umbricians</Authors>
    <Version>0.1.0</Version>
    <PackageTags>umbraco;umbraco-marketplace;media;automate</PackageTags>
    <PackageIcon>icon.png</PackageIcon>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Copyright>Copyright (c) 2026 FYIN LLC (trading as Umbricians)</Copyright>
    <PackageProjectUrl>https://github.com/Umbricians/Media-Curator</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Umbricians/Media-Curator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbricians.MediaCurator\Umbricians.MediaCurator.csproj" />
    <!-- Override WorkflowCore 3.9.0's vulnerable transitive OpenTelemetry.Api dependency. -->
    <PackageReference Include="OpenTelemetry.Api" />
    <!-- Overrides Umbraco/Microsoft.Data.Sqlite's vulnerable transitive SQLitePCLRaw 2.x native bundle. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" PrivateAssets="all" />
    <PackageReference Include="Umbraco.Automate.Core" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rendered from assets/logo.svg; NuGet recommends 128x128. -->
    <None Include="..\..\assets\logo-128.png" Pack="true" PackagePath="\icon.png" Visible="false" />
  </ItemGroup>
</Project>
