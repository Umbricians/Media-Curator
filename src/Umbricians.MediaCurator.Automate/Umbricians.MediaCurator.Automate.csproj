<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageId>Umbricians.MediaCurator.Automate</PackageId>
    <Title>Umbricians.MediaCurator for Umbraco.Automate</Title>
    <Description>Umbraco.Automate triggers and actions for MediaCurator. Tracks the pre-release Umbraco.Automate API and is versioned independently of the core package (§9).</Description>
    <!-- Pre-release while Umbraco.Automate itself is pre-release -->
    <Version>0.1.0-beta</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Umbricians.MediaCurator\Umbricians.MediaCurator.csproj" />
    <!-- Override WorkflowCore 3.9.0's vulnerable transitive OpenTelemetry.Api dependency. -->
    <PackageReference Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageReference Include="Umbraco.Automate.Core" Version="17.4.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Remove="Client\**" />
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>
</Project>
