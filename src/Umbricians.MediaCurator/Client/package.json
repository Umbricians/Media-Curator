    "@types/react-dom": "^19.3.0",
    "@umbraco-cms/backoffice": "17.8.2",
    "@vitejs/plugin-react": "^6.3.0",
    "chalk": "^6.0.1",
    "cross-env": "^10.1.0",
    "node-fetch": "^3.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.4.0",
    "vitest": "^5.1.2"
  },
