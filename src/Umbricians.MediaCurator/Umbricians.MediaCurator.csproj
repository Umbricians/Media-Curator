<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AddRazorSupportForMvc Condition="'$(SupportPagesAndViews)' == 'True'">true</AddRazorSupportForMvc>
    <RootNamespace Condition="'$(name)' != '$(name{-VALUE-FORMS-}safe_namespace)'">Umbricians.MediaCurator</RootNamespace>
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>Umbricians.MediaCurator</PackageId>
    <Product>Umbricians.MediaCurator</Product>
    <Title>Umbricians.MediaCurator</Title>
    <Version>0.1.0</Version>
    <Authors>Chris (Umbricians)</Authors>
    <Description>Automatically categorizes and organizes images in the Umbraco Media section. Pluggable curation providers (date, EXIF, AI tags, color, library classification and more), scoped and nested rulesets with a visual designer, consent-based media type provisioning, dry-run preview, activity log with undo.</Description>
    <PackageTags>umbraco;umbraco-marketplace;media;ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup Condition="'$(SupportPagesAndViews)' == 'True'">
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>


  <!-- Per-project - with versions -->
  <ItemGroup>
    <PackageReference Include="MetadataExtractor" Version="2.9.3" />
    <!-- Override Umbraco CMS' vulnerable transitive MessagePack dependency. -->
    <PackageReference Include="MessagePack" Version="3.1.8" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="Umbraco.AI" Version="17.4.0" />
    <PackageReference Include="Umbraco.Cms.Api.Common" Version="17.7.0" />
    <PackageReference Include="Umbraco.Cms.Api.Management" Version="17.7.0" />

    <!--
      Swashbuckle is available transitively from the Umbraco packages above, but we take a direct
      dependency here because extension code directly uses types from Swashbuckle (SwaggerGenOptions)
      and Microsoft.OpenApi (OpenApiInfo). Without a direct reference, this project's Swashbuckle
      version is determined solely by NuGet's transitive resolution, which can resolve to a different
      version than the host site project (e.g. a newer patch). When that happens, the different
      Microsoft.OpenApi versions (a transitive dependency of Swashbuckle) can conflict at runtime,
      causing custom Swagger documents registered by the extension to fail to appear.
      Most other transitive dependencies don't have this problem because extension code doesn't
      use their types directly - only Swashbuckle/OpenApi types are referenced in the composer.
    -->
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <PackageReference Include="Umbraco.Cms.Web.Common" Version="17.7.0" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.7.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Don't include the client folder as part of packaging nuget build -->
    <Content Remove="Client\**" />

    <!-- However make the Umbraco-package.json included for dotnet pack or nuget package and visible to the solution -->
    <None Include="Client\public\umbraco-package.json" Pack="false" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Umbricians.MediaCurator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Schemes\Resources\*.txt" />
  </ItemGroup>

</Project>
