<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sites on Umbraco 17.7.0 or later resolve their own newer versions. -->
    <PackageVersion Include="Umbraco.Cms.Api.Common" Version="17.7.0" />
    <PackageVersion Include="Umbraco.Cms.Api.Management" Version="17.7.0" />
    <PackageVersion Include="Umbraco.Cms.Web.Common" Version="17.7.0" />
    <PackageVersion Include="Umbraco.AI" Version="17.4.0" />
    <PackageVersion Include="Umbraco.Automate.Core" Version="17.4.0" />

    <PackageVersion Include="MetadataExtractor" Version="2.9.3" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />

    <!-- Security overrides for vulnerable transitive dependencies. -->
    <PackageVersion Include="MessagePack" Version="3.1.8" />
    <PackageVersion Include="OpenTelemetry.Api" Version="1.15.3" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.3" />
  </ItemGroup>
</Project>
