{
  "$schema": "appsettings-schema.json",
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information"
    },
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "umbracoDbDSN": "Server=localhost,1433;Database=umbracoDb;User Id=sa;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;Pooling=True;",
    "umbracoDbDSN_ProviderName": "Microsoft.Data.SqlClient",
    "umbracoAutomateDbDSN": "Server=localhost,1433;Database=umbracoAutomateDb;User Id=sa;Password=YOUR_SQL_PASSWORD;TrustServerCertificate=True;Pooling=True;",
    "umbracoAutomateDbDSN_ProviderName": "Microsoft.Data.SqlClient"
  },
  "MediaCurator": {
    "RecognitionProfileAlias": "test-profile",
    "ClassificationSchemeAlias": "dewey-pd",
    "MaxRecognitionEdgePixels": 1024,
    "RecognitionPreparedImageTestFolder": "../../src/Umbricians.MediaCurator/Recognition/test-output"
  },
  "Umbraco": {
    "Automate": {
      "Execution": {
        "MaxConcurrentRuns": 1
      },
      "RateLimiting": {
        "MaxConcurrentRunsPerAutomation": 1
      },
      "Outbox": {
        "MaxRetries": 12,
        "BaseRetryDelay": "00:00:10"
      }
    },
    "CMS": {
      "Global": {
        "DisableElectionForSingleServer": true
      },
      "WebRouting": {
        "UmbracoApplicationUrl": "http://localhost:40264"
      },
      "Unattended": {
        "InstallUnattended": true,
        "UnattendedUserName": "Admin",
        "UnattendedUserEmail": "admin@example.com",
        "UnattendedUserPassword": "CHANGE_ME_TO_A_STRONG_PASSWORD",
        "UnattendedTelemetryLevel": "Minimal"
      },
      "Hosting": {
        "Debug": true
      },
      "Imaging": {
        "HMACSecretKey": "CHANGE_ME_TO_A_BASE64_HMAC_SECRET"
      }
    }
  }
}
